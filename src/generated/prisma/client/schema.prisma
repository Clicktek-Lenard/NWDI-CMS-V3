  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt  @id
  queue        String? @db.VarChar(255)
  payload      String?
  attempts     Int
  reserved_at  Int?
  available_at Int
  created_at   Int
}

model migrations {
  id        Int     @id
  migration String? @db.VarChar(255)
  batch     Int
}

