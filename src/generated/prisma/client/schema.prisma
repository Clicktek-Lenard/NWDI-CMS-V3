generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  Int       @id @default(autoincrement()) @db.UnsignedInt
  email               String?
  password            String
  permissions         String?   @db.Text
  activated           Boolean   @default(false)
  created_by          Int?
  activation_code     String?
  activated_at        DateTime? @db.Timestamp(0)
  last_login          DateTime? @db.Timestamp(0)
  persist_code        String?
  reset_password_code String?
  first_name          String?
  last_name           String?
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @updatedAt @db.Timestamp(0)
  deleted_at          DateTime? @db.Timestamp(0)
  website             String?
  country             String?
  gravatar            String?
  location_id         Int?
  phone               String?
  jobtitle            String?
  manager_id          Int?
  employee_num        String?   @db.Text
  avatar              String?
  username            String?   @unique(map: "username")
  notes               String?   @db.Text
  company_id          Int?      @db.UnsignedInt
  remember_token      String?   @db.Text
  ldap_import         Boolean   @default(false)
  locale              String?   @default("en") @db.VarChar(10)
  show_in_list        Boolean   @default(true)
  two_factor_secret   String?   @db.VarChar(32)
  two_factor_enrolled Boolean   @default(false)
  two_factor_optin    Boolean   @default(false)
  department_id       Int?
  address             String?
  city                String?
  state               String?   @db.VarChar(3)
  zip                 String?   @db.VarChar(10)
  skin                String?
  remote              Boolean?  @default(false)
  status              String    @default("ACTIVE") @db.VarChar(15)
  is_deleted          Boolean   @default(false)
  role                String?   @db.Text
  department          String?   @db.VarChar(100)
  AccessMapId         String    @default("0") @db.VarChar(30)
  ldap_server_status  String?   @db.VarChar(255)

  @@index([AccessMapId], map: "AccessMapId")
  @@index([activation_code], map: "users_activation_code_index")
  @@index([company_id], map: "users_company_id_index")
  @@index([reset_password_code], map: "users_reset_password_code_index")
  @@map("users")
}

model Queue {
  Id                   BigInt    @id @default(autoincrement())
  IdBU                 String?   @db.VarChar(10)
  Code                 String    @db.VarChar(20)
  Date                 DateTime  @db.Date
  AnteDateQueueID      BigInt?   @default(0)
  AnteDate             DateTime? @db.Date
  AnteDateCode         String?   @db.VarChar(30)
  AnteDateTime         DateTime? @db.DateTime(0)
  AnteDateStatus       Int       @default(0) @db.SmallInt
  AnteDateReason       String?   @db.VarChar(2000)
  AnteDateApprovedBy   String?   @db.VarChar(30)
  AnteDateApprovedDate DateTime? @db.DateTime(0)
  DateTime             DateTime  @db.DateTime(0)
  IdPatient            BigInt
  QFullName            String?   @db.VarChar(200)
  QLastName            String?   @db.VarChar(80)
  QFirstName           String?   @db.VarChar(150)
  QMiddleName          String?   @db.VarChar(80)
  QGender              String?   @db.VarChar(10)
  QDOB                 DateTime? @db.Date
  QFullAddress         String?   @db.VarChar(500)
  AgePatient           Int?
  Status               Int       @db.SmallInt
  AccessionNo          String?   @db.VarChar(20)
  Notes                String?   @db.LongText
  CancelReason         String?   @db.VarChar(2000)
  PatientType          String?   @db.VarChar(80)
  Picture              String?   @db.VarChar(200)
  InputBy              String    @db.VarChar(30)
  Lab2LabId            String?   @db.VarChar(30)
  LabBarcode           String?   @db.VarChar(30)
  LabId                String?   @db.VarChar(30)
  UpdateDate           DateTime? @db.Date
  UpdateBy             String?   @db.VarChar(80)
  ErosStatus           String?   @db.VarChar(30)
  SystemUpdateTime     DateTime? @default(now()) @db.Timestamp(0)

  @@index([AccessionNo], map: "AccessionNo")
  @@index([Code], map: "Code")
  @@index([Date], map: "Date")
  @@index([IdBU], map: "INDEX")
  @@index([InputBy], map: "InputBy")
  @@index([Lab2LabId], map: "Lab2LabId")
  @@index([IdPatient], map: "Queue_FK_IdPatient")
  @@index([Status], map: "Status")
  @@map("queue")
}

model CardEnrollment {
  Id           Int       @id @default(autoincrement())
  CardNumber   String?   @unique(map: "CardNumber_2") @db.VarChar(20)
  DateEnrolled DateTime? @db.DateTime(0)
  DateRelease  DateTime? @db.DateTime(0)
  ReleaseTo    String?   @db.VarChar(20)
  OldReleaseTo String?   @db.VarChar(20)
  ReleaseBy    String?   @db.VarChar(20)
  ReceivedBy   String?   @db.VarChar(20)
  ReceivedDate DateTime? @db.DateTime(0)
  Status       Int?
  TransferTo   String?   @db.VarChar(20)
  DateTransfer DateTime? @db.DateTime(0)
  TransferBy   String?   @db.VarChar(20)

  @@map("cardenrollment")
}

model CardVerified {
  Id                  Int       @id @default(autoincrement())
  VerifiedCardNumbers String    @unique(map: "VerifiedCardNumbers") @db.VarChar(16)
  ICTReceived         String?   @db.VarChar(20)
  DateReceived        DateTime? @db.DateTime(0)

  @@map("cardverified")
}

model CardNumber {
  Id                  Int     @id @default(autoincrement())
  Year                String? @db.VarChar(5)
  Batch               String? @db.VarChar(5)
  Month               String? @db.VarChar(5)
  SeriesNum           String? @db.VarChar(20)
  MaskedSeries        String? @db.VarChar(20)
  GeneratedCardNumber String  @unique(map: "GeneratedCardNumber") @db.VarChar(50)
  CodeCompany         String  @db.VarChar(50)
  GeneratedBy         String  @db.VarChar(50)

  @@map("cardkey")
}

model Transaction {
  Id                   Int       @id @default(autoincrement())
  IdQueue              BigInt
  Date                 DateTime  @db.Date
  IdDoctor             Int?
  NameDoctor           String?   @db.VarChar(100)
  IdCompany            Int
  NameCompany          String?   @db.VarChar(500)
  TransactionType      String    @db.VarChar(30)
  AccessionNo          String?   @default("") @db.VarChar(20)
  IdItemPrice          Int
  ItemUsedItemPrice    Int       @default(0) @db.TinyInt
  CodeItemPrice        String?   @db.VarChar(100)
  DescriptionItemPrice String?   @db.VarChar(500)
  PriceGroupItemPrice  String?   @db.VarChar(50)
  AmountItemPrice      Float     @db.Float
  AmountRemaining      Float     @default(0) @db.Float
  ReadersFee           Float     @default(0) @db.Float
  OrigAmount           Float     @default(0) @db.Float
  HCardNumber          String?   @db.VarChar(20)
  GroupItemMaster      String?   @default("Y") @db.VarChar(10)
  UsedPercentDefault   Int       @default(0) @db.TinyInt
  ShowCompanyId        String?   @db.VarChar(30)
  InputBy              String    @db.VarChar(100)
  InputId              Int
  UpdateDateTime       DateTime? @db.DateTime(0)
  UpdateBy             String?   @db.VarChar(50)
  Status               Int       @default(0)
  Stat                 String?   @default("") @db.VarChar(3)
  Token                String?   @db.VarChar(255)
  SystemUpdateTime     DateTime? @default(now()) @db.Timestamp(0)
  ResultOnlineStatus   String?   @db.VarChar(30)

  @@index([IdQueue], map: "IdQueue")
  @@index([Id], map: "Status")
  @@map("transactions")
}

model Company {
  Id                    Int       @id @default(autoincrement())
  IdBU                  String    @default("ALL") @db.VarChar(10)
  Num                   BigInt?
  Code                  String    @db.VarChar(50)
  Name                  String    @db.VarChar(500)
  NameOld               String?   @db.VarChar(500)
  ShortName             String?   @db.VarChar(80)
  Group                 String?   @db.VarChar(80)
  SubGroup              String?   @db.VarChar(80)
  BillingType           String?   @db.VarChar(80)
  Address               String?   @db.VarChar(500)
  Phone                 String?   @db.VarChar(50)
  City                  String?   @db.VarChar(50)
  Email                 String?   @db.VarChar(300)
  Status                String    @db.VarChar(10)
  StatusOnSite          String?   @default("Inactive") @db.VarChar(10)
  Notes                 String?   @db.MediumText
  StartDate             DateTime? @db.Date
  EndDate               DateTime? @db.Date
  InputBy               String    @db.VarChar(50)
  InputDate             DateTime  @db.Date
  UpdateBy              String?   @db.VarChar(50)
  UpdateDate            DateTime? @db.Date
  ErosCode              String    @db.VarChar(80)
  SalesCode             String?   @db.VarChar(50)
  SalesName             String?   @db.VarChar(80)
  ContactNo             Int?
  Designation           String?   @db.VarChar(150)
  ResultUploading       String?   @db.VarChar(3)
  UsedPriceDefault      String    @default("None") @db.VarChar(4)
  UsedPercentDefaultLAB Int       @default(0) @db.TinyInt
  UsedPercentDefaultIMG Int       @default(0) @db.TinyInt
  UsedPercentDefault    Int       @default(0) @db.TinyInt
  UsedPercentItemGroup  String?   @db.VarChar(200)
  UsedPercentItemCode   String?   @db.MediumText
  UsedLessReadersFee    String?   @default("No") @db.VarChar(3)
  UsedLessRebates       String?   @default("No") @db.VarChar(3)
  UsedClinic            String?   @default("ALL") @db.VarChar(500)
  ChargeTo              String?   @db.VarChar(15)
  Remarks               String    @db.MediumText
  OptionalItemCode      String?   @db.VarChar(200)
  EnabledEndDate        String    @db.Char(1)
  EmpId                 String?   @db.VarChar(15)
  EvaluatorId           String?   @db.VarChar(255)
  Parent                BigInt    @default(0)
  KeyLeft               Int       @default(0)
  KeyRight              Int       @default(0)
  CebuStatus            String?   @db.VarChar(30)
  SMBStatus             String?   @db.VarChar(10)
  TARStatus             String?   @db.VarChar(10)
  DAVStatus             String?   @db.VarChar(10)
  LINStatus             String?   @db.VarChar(10)
  reUpload              String?   @db.VarChar(30)

  @@unique([Code, ErosCode], map: "UNIQUE")
  @@index([Code, ErosCode], map: "INDEX")
  @@index([UsedClinic, UsedLessReadersFee, UsedPercentDefault, UsedPercentItemGroup, UsedPriceDefault, UsedPercentDefaultIMG, UsedPercentDefaultLAB], map: "Used")
  @@map("company")
}

