/// Real CMS V2 vitals table — Medication/LastDose/LastPeriod recorded at nursing station
model CmsVitals {
  Id             BigInt    @id @default(autoincrement())
  IdQueue        BigInt    @unique(map: "UNIQUE")
  Medication     String?   @db.VarChar(250)
  LastDose       DateTime? @db.DateTime(0)
  LastPeriod     DateTime? @db.Date
  InputBy        String    @db.VarChar(30)
  InputDateTime  DateTime  @db.DateTime(0)
  UpdateBy       String?   @db.VarChar(30)
  UpdateDateTime DateTime? @db.DateTime(0)

  @@map("vitals")
}

