  history_illness String?
  past_history    String?
  family_history  String?
  pe_findings     String?
  diagnosis       String?
  icd_code        String?  @db.VarChar(20)
  treatment_plan  String?
  orders          String?
  pcp_doctor      String?  @db.VarChar(200)
  doctor_id       Int?
  doctor_name     String?  @db.VarChar(200)
  is_draft        Int      @default(1)
  status          String?  @db.VarChar(30)
  recorded_by     Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("consultation_notes")
}

/// Replaces the medical-history / PE-findings portion of v1 `physicalexaminationreport` (@@ignore).
model PhysicalExamination {
  id                  Int       @id @default(autoincrement())
  queue_id            Int       @unique
  patient_id          String?   @db.VarChar(50)
  hypertension        Boolean   @default(false)
  diabetes            Boolean   @default(false)
  asthma              Boolean   @default(false)
  heart_disease       Boolean   @default(false)
  thyroid_disease     Boolean   @default(false)
  kidney_disease      Boolean   @default(false)
  allergies           Boolean   @default(false)
  allergies_specify   String?   @db.VarChar(200)
  surgery_history     Boolean   @default(false)
  surgery_specify     String?   @db.VarChar(200)
  smoker              Boolean   @default(false)
  pack_years          Float?
  alcoholic           Boolean   @default(false)
  lmp                 DateTime? @db.Date
  gravida             Int?
  para                Int?
  family_hypertension Boolean   @default(false)
  family_diabetes     Boolean   @default(false)
  family_cancer       Boolean   @default(false)
  skin                String?
  heent               String?
  neck                String?
  chest_lungs         String?
  heart               String?
  abdomen             String?
  extremities         String?
  neurological        String?
  fitness_class       String?   @db.VarChar(50)
  recorded_by         Int?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("physical_examinations")
}

/// Replaces v1 `peassesandrec` (@@ignore). Composite key (queue_id, item_code) — one row per exam item.
model MedicalEvaluation {
  id             Int      @id @default(autoincrement())
  queue_id       Int
  patient_id     String?  @db.VarChar(50)
  item_code      String   @db.VarChar(30)
  item_name      String?  @db.VarChar(300)
  findings       String?
  assessment     String?
  recommendation String?
  class_value    String?  @db.VarChar(10)
  recorded_by    Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([queue_id, item_code], name: "queue_id_item_code")
  @@map("medical_evaluations")
}

model Prescription {
  id          Int                @id @default(autoincrement())
  queue_id    BigInt
  patient_id  BigInt
  doctor_name String?            @db.VarChar(200)
  notes       String?
  printed_at  DateTime?
  input_by    String?            @db.VarChar(50)
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt
  items       PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id              Int          @id @default(autoincrement())
  prescription_id Int
  medication      String       @db.VarChar(300)
  dosage          String?      @db.VarChar(100)
  frequency       String?      @db.VarChar(100)
  duration        String?      @db.VarChar(100)
  quantity        Int?
  instructions    String?
  prescription    Prescription @relation(fields: [prescription_id], references: [id])

  @@map("prescription_items")
}

/// One row per accession item. Status: PENDING → ENCODED → VALIDATED → RELEASED
model ResultValue {
  id               Int       @id @default(autoincrement())
  accession_id     BigInt    @unique
  queue_id         BigInt
  item_code        String?   @db.VarChar(30)
  item_description String?   @db.VarChar(500)
  result_value     String?   @db.VarChar(500)
  result_unit      String?   @db.VarChar(50)
  normal_range     String?   @db.VarChar(100)
  flag             String?   @db.VarChar(5)
  remarks          String?
  encoded_by       String?   @db.VarChar(50)
  encoded_at       DateTime?
  validated_by     String?   @db.VarChar(50)
  validated_at     DateTime?
  status           String    @default("PENDING") @db.VarChar(20)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("result_values")
}

model ImagingResult {
  id               Int       @id @default(autoincrement())
  accession_id     BigInt    @unique
  queue_id         BigInt
  item_code        String?   @db.VarChar(30)
  item_description String?   @db.VarChar(500)
  interpretation   String?
  impression       String?
  radiologist_name String?   @db.VarChar(200)
  encoded_by       String?   @db.VarChar(50)
  encoded_at       DateTime?
  validated_by     String?   @db.VarChar(50)
  validated_at     DateTime?
  status           String    @default("PENDING") @db.VarChar(20)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("imaging_results")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model cardNumber {
  id                  Int     @id @map("Id")
  year                String? @map("Year") @db.VarChar(5)
  batch               String? @map("Batch") @db.VarChar(5)
  month               String? @map("Month") @db.VarChar(5)
  seriesNum           String? @map("SeriesNum") @db.VarChar(20)
  maskedSeries        String? @map("MaskedSeries") @db.VarChar(20)
  generatedcardnumber String? @map("GeneratedCardNumber") @db.VarChar(50)
  codeCompany         String? @map("CodeCompany") @db.VarChar(50)
  generatedBy         String? @map("GeneratedBy") @db.VarChar(50)

  @@map("cardkey")
}

model cardVerified {
  id                  Int       @id @map("Id")
  verifiedcardnumbers String?   @map("VerifiedCardNumbers") @db.VarChar(16)
  ictreceived         String?   @map("ICTReceived") @db.VarChar(20)
  datereceived        DateTime? @map("DateReceived") @db.Timestamp(6)

  @@map("cardverified")
}

model appointment {
  Id              BigInt    @id @default(autoincrement()) @map("id")
  IdBU            String    @map("idbu") @db.VarChar(10)
  IdPatient       BigInt    @map("idpatient")
  PatientName     String?   @map("patientname") @db.VarChar(200)
  IdPhysician     BigInt    @map("idphysician")
  PhysicianName   String?   @map("physicianname") @db.VarChar(200)
  AppointmentDate DateTime  @map("appointmentdate") @db.Date
  TimeSlot        String?   @map("timeslot") @db.VarChar(20)
  Notes           String?   @map("notes") @db.VarChar(2000)
  IdQueue         BigInt?   @map("idqueue")
  Status          Int       @default(201) @map("status") @db.SmallInt
  InputBy         String?   @map("inputby") @db.VarChar(30)
  InputDateTime   DateTime  @default(now()) @map("inputdatetime") @db.Timestamp(6)
  UpdateBy        String?   @map("updateby") @db.VarChar(30)
  UpdateDateTime  DateTime? @map("updatedatetime") @db.Timestamp(6)

  @@index([IdBU, AppointmentDate])
  @@index([IdPhysician, AppointmentDate])
  @@index([IdPatient])
  @@map("appointment")
}

model sendout {
  Id            BigInt    @id @default(autoincrement()) @map("id")
  IdQueue       BigInt    @map("idqueue")
  QueueCode     String?   @map("queuecode") @db.VarChar(30)
  PatientName   String?   @map("patientname") @db.VarChar(200)
  IdBUFrom      String    @map("idbufrom") @db.VarChar(10)
  IdBUTo        String    @map("idbuto") @db.VarChar(10)
  Items         String?   @map("items")
  Notes         String?   @map("notes") @db.VarChar(2000)
  Status        Int       @default(201) @map("status") @db.SmallInt
  SentBy        String?   @map("sentby") @db.VarChar(30)
  SentDate      DateTime  @default(now()) @map("sentdate") @db.Timestamp(6)
  ReceivedBy    String?   @map("receivedby") @db.VarChar(30)
  DateReceived  DateTime? @map("datereceived") @db.Timestamp(6)
  CompletedBy   String?   @map("completedby") @db.VarChar(30)
  DateCompleted DateTime? @map("datecompleted") @db.Timestamp(6)
  UpdateBy      String?   @map("updateby") @db.VarChar(30)
  UpdateDate    DateTime? @map("updatedate") @db.Timestamp(6)

  @@index([IdBUFrom, SentDate])
  @@index([IdBUTo, Status])
  @@index([IdQueue])
  @@map("sendout")
}
