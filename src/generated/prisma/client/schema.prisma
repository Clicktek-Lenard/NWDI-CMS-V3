  BatchCode       String?   @db.VarChar(50)
  QueueCode       String?   @db.VarChar(50)
  PatientName     String?   @db.VarChar(300)
  ItemDescription String?   @db.VarChar(100)
  Tubes           Int?
  ReceivedTime    DateTime? @db.DateTime(0)
  ReceivedBy      String?   @db.VarChar(100)
  rowIndex        Int?
}

model transport {
  Id                BigInt    @id @default(autoincrement())
  BatchCode         String    @db.VarChar(50)
  Quantity          Int
  TransportDate     DateTime  @db.DateTime(0)
  FromBU            String    @db.VarChar(10)
  ToBU              String    @db.VarChar(10)
  Status            String    @db.VarChar(50)
  PreparedBy        String    @db.VarChar(100)
  DepartureDateTime DateTime  @db.DateTime(0)
  ArrivalDateTime   DateTime? @db.DateTime(0)
}

model updatequeue {
  Id        BigInt @id @default(autoincrement())
  Module    String @db.VarChar(50)
  ModuleId  BigInt
  QueueCode String @db.VarChar(30)
  Status    Int    @db.SmallInt
}

model userhclab {
  Id                 Int      @id @unique(map: "Id") @default(autoincrement())
  ADId               Int?
  UserID             String   @unique(map: "UserID") @db.VarChar(255)
  Password           String   @db.VarChar(20)
  UserName           String   @db.VarChar(255)
  Status             String?  @db.VarChar(100)
  LSCode             String?  @db.VarChar(255)
  UserCtlFlag        String   @db.VarChar(255)
  UserCtlFlag1       String   @db.VarChar(255)
  UserLdapID         String?  @db.VarChar(255)
  UserWeSiteID       String?  @db.VarChar(10)
  PasswordLastChange String?  @db.VarChar(255)
  UserFingerPrint    String?  @db.VarChar(10)
  UserRemark         String?  @db.VarChar(200)
  UserUpdateBy       String?  @db.VarChar(255)
  UserUpdateOn       DateTime @default(now()) @db.DateTime(0)
  StatusSMB          String?  @db.VarChar(30)
  StatusTAR          String?  @db.VarChar(30)
  StatusCEB          String?  @db.VarChar(30)
  StatusDAV          String?  @db.VarChar(30)
}

model webitemprice {
  Id          Int     @id @default(autoincrement())
  Code        String  @db.VarChar(30)
  Description String  @db.VarChar(500)
  Price       String? @db.VarChar(30)
  GroupName   String  @db.VarChar(100)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model zip {
  zip_id   BigInt @id @default(autoincrement())
  zip_code Int    @default(0)
  zip_name String @db.VarChar(255)
  zip_city BigInt
}

enum hl7_generation_logs_Hl7Type {
  LAB
  RAD
}
