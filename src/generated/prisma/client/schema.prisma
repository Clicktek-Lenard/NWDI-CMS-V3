generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String?   @db.VarChar(191)
  password            String?   @db.VarChar(191)
  permissions         String?
  activated           Boolean
  created_by          Int?
  activation_code     String?   @db.VarChar(191)
  activated_at        DateTime? @db.Timestamp(6)
  last_login          DateTime? @db.Timestamp(6)
  persist_code        String?   @db.VarChar(191)
  reset_password_code String?   @db.VarChar(191)
  first_name          String?   @db.VarChar(191)
  last_name           String?   @db.VarChar(191)
  created_at          DateTime? @db.Timestamp(6)
  updated_at          DateTime? @db.Timestamp(6)
  deleted_at          DateTime? @db.Timestamp(6)
  website             String?   @db.VarChar(191)
  country             String?   @db.VarChar(191)
  gravatar            String?   @db.VarChar(191)
  location_id         Int?
  phone               String?   @db.VarChar(191)
  jobtitle            String?   @db.VarChar(191)
  manager_id          Int?
  employee_num        String?
  avatar              String?   @db.VarChar(191)
  username            String?   @unique(map: "users_username_unique") @db.VarChar(191)
  notes               String?
  company_id          Int?
  remember_token      String?
  ldap_import         Boolean
  locale              String?   @db.VarChar(10)
  show_in_list        Boolean
  two_factor_secret   String?   @db.VarChar(32)
  two_factor_enrolled Boolean
  two_factor_optin    Boolean
  department_id       Int?
  address             String?   @db.VarChar(191)
  city                String?   @db.VarChar(191)
  state               String?   @db.VarChar(3)
  zip                 String?   @db.VarChar(10)
  skin                String?   @db.VarChar(191)
  remote              Boolean?
  status              String?   @db.VarChar(15)
  role                String?   @db.VarChar(2500)
  department          String?   @db.VarChar(100)
  accessmapid         String?   @db.VarChar(30)
  ldap_server_status  String?   @db.VarChar(255)

  @@map("users")
}

