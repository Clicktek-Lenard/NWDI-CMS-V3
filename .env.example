# Timezone - keep aligned with the application locale
TZ=Asia/Manila

# Auth.js (NextAuth v5) - REQUIRED
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Database - PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cms_v2?schema=public"
AUDIT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cms_audit?schema=public"

# LDAP (optional - leave blank if not configured)
# LDAP_SERVER=ldap://your-dc.domain.local
# LDAP_DOMAIN=your.domain
# LDAP_BASE_DN=DC=your,DC=domain
